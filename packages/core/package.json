{
  "name": "@shardjs/core",
  "version": "0.1.0",
  "description": "Core runtime, routing and client abstractions for the shard Discord bot framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shardjs/api": "workspace:*",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "picocolors": "^1.1.1",
    "ws": "8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "8.5.14",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
