{
  "name": "@shardjs/cli",
  "version": "0.1.0",
  "description": "Next.js-like CLI for the shard Discord bot framework",
  "type": "module",
  "bin": {
    "shard": "./bin/shard.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.2",
    "@shardjs/api": "workspace:*",
    "@shardjs/core": "workspace:*",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "discord-api-types": "^0.37.119",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
